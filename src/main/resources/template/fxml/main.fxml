<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane fx:id="mainContainer" styleClass="main-root" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.miapeve.finance.ui.MainController">

   <!-- ================= TOP : MENU + TOOLBAR ================= -->
   <top>
      <VBox styleClass="top-bar-container">

         <MenuBar styleClass="menu-bar-modern">
            <Menu text="Fichier">
               <MenuItem text="Déconnexion" onAction="#handleDeconnexion" styleClass="menu-item-danger"/>
            </Menu>
            <Menu text="Compte">
               <MenuItem text="Mon Profil" onAction="#handleMonProfil"/>
               <MenuItem text="À propos" onAction="#handleAPropos"/>
            </Menu>
         </MenuBar>

         <HBox styleClass="toolbar-modern" alignment="CENTER_LEFT" spacing="14">

            <!-- Fil d'Ariane : icône + titre de la vue courante -->
            <FontAwesomeIconView glyphName="DASHBOARD" styleClass="breadcrumb-icon" glyphSize="16"/>
            <Label fx:id="appTitle" text="Tableau de Bord" styleClass="breadcrumb-current"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Barre de recherche (UI uniquement, non branchée à une recherche réelle) -->
            <HBox styleClass="search-bar" alignment="CENTER_LEFT" spacing="8" prefWidth="240">
               <FontAwesomeIconView glyphName="SEARCH" styleClass="nav-icon-sm"/>
               <TextField promptText="Rechercher..." HBox.hgrow="ALWAYS"/>
               <Label text="Ctrl+K" styleClass="search-shortcut-hint"/>
            </HBox>

            <Region styleClass="toolbar-separator"/>

            <!-- Accueil -->
            <Button styleClass="btn-ghost-sm" onAction="#loadDashboard">
               <graphic>
                  <FontAwesomeIconView glyphName="HOME" styleClass="nav-icon-sm"/>
               </graphic>
            </Button>

            <!-- Notifications -->
            <StackPane>
               <Button styleClass="btn-ghost-sm">
                  <graphic>
                     <FontAwesomeIconView glyphName="BELL" styleClass="nav-icon-sm"/>
                  </graphic>
               </Button>
               <Label fx:id="notificationBadge" text="3" styleClass="badge-count"
                      StackPane.alignment="TOP_RIGHT" visible="false" managed="false"/>
            </StackPane>

            <!-- Aide -->
            <Button styleClass="btn-ghost-sm" onAction="#handleDocumentation">
               <graphic>
                  <FontAwesomeIconView glyphName="QUESTION_CIRCLE" styleClass="nav-icon-sm"/>
               </graphic>
            </Button>

            <Region styleClass="toolbar-separator"/>

            <!-- Bloc profil -->
            <HBox styleClass="profile-menu-trigger" alignment="CENTER_LEFT" spacing="10"
                  onMouseClicked="#handleMonProfil">
               <Label fx:id="userInitialsLabel" text="AD" styleClass="avatar-circle, avatar-initials"
                      alignment="CENTER" prefWidth="36" prefHeight="36"/>
               <VBox spacing="0">
                  <Label fx:id="userNameLabel" text="Admin" styleClass="profile-name"/>
                  <Label fx:id="userRoleLabel" text="Administrateur" styleClass="profile-role"/>
               </VBox>
               <FontAwesomeIconView glyphName="CHEVRON_DOWN" styleClass="nav-icon-sm" glyphSize="10"/>
            </HBox>

         </HBox>
      </VBox>
   </top>

   <!-- ================= SIDEBAR ================= -->
   <left>
      <VBox fx:id="sidebar" styleClass="sidebar-modern">

         <!-- Bloc marque -->
         <HBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="10">
            <StackPane styleClass="sidebar-logo-icon">
               <Label text="M" styleClass="sidebar-logo-initials"/>
            </StackPane>
            <VBox spacing="0">
               <Label text="Miapeve Finance" styleClass="sidebar-logo-title"/>
               <Label text="Gestion financière" styleClass="sidebar-logo-subtitle"/>
            </VBox>
         </HBox>

         <Region styleClass="sidebar-divider"/>

         <!-- Section GESTION -->
         <Label text="GESTION" styleClass="sidebar-section-label"/>

         <Button fx:id="btnDashboard" text="Tableau de Bord" styleClass="nav-button"
                 onAction="#loadDashboard" maxWidth="Infinity">
            <graphic>
               <FontAwesomeIconView glyphName="DASHBOARD" styleClass="nav-icon"/>
            </graphic>
         </Button>
         <Button fx:id="btnProgrammes" text="Programmes" styleClass="nav-button"
                 onAction="#loadProgrammes" maxWidth="Infinity">
            <graphic>
               <FontAwesomeIconView glyphName="CALENDAR" styleClass="nav-icon"/>
            </graphic>
         </Button>
         <Button fx:id="btnComptes" text="Comptes" styleClass="nav-button"
                 onAction="#loadComptes" maxWidth="Infinity">
            <graphic>
               <FontAwesomeIconView glyphName="BANK" styleClass="nav-icon"/>
            </graphic>
         </Button>
         <Button fx:id="btnTransactions" text="Transactions" styleClass="nav-button"
                 onAction="#loadTransactions" maxWidth="Infinity">
            <graphic>
               <FontAwesomeIconView glyphName="EXCHANGE" styleClass="nav-icon"/>
            </graphic>
         </Button>

         <!-- Section PARAMÈTRES -->
         <Label text="PARAMÈTRES" styleClass="sidebar-section-label"/>

         <Button fx:id="btnParametres" text="Paramètres" styleClass="nav-button"
                 onAction="#loadParametres" maxWidth="Infinity">
            <graphic>
               <FontAwesomeIconView glyphName="GEAR" styleClass="nav-icon"/>
            </graphic>
         </Button>
         <Button fx:id="btnImpression" text="Impression" styleClass="nav-button"
                 onAction="#loadImpression" maxWidth="Infinity">
            <graphic>
               <FontAwesomeIconView glyphName="PRINT" styleClass="nav-icon"/>
            </graphic>
         </Button>

         <Region VBox.vgrow="ALWAYS"/>

         <!-- Footer -->
         <VBox styleClass="sidebar-footer" spacing="2">
            <padding>
               <Insets top="12" right="20" bottom="16" left="20"/>
            </padding>
            <Label text="Version 2.0.0" styleClass="sidebar-version"/>
            <Label text="© 2026 Miapeve Finance" styleClass="sidebar-copyright"/>
         </VBox>

      </VBox>
   </left>

   <!-- ================= CONTENU ================= -->
   <center>
      <StackPane fx:id="contentArea" styleClass="content-area-modern"/>
   </center>

</BorderPane>
